{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node scripts/buildOfflineManifest.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "fetch:encounters": "node scripts/fetchEncounters.mjs",
    "generate:gates": "node scripts/generateMilestoneGates.mjs",
    "fetch:evolution-edges": "node scripts/fetchEvolutionEdges.mjs",
    "test:evolution": "tsx tests/pokepetEvolution.test.ts",
    "test:offline": "node tests/offline.browser.mjs",
    "fetch:offline-fonts": "node scripts/fetchOfflineFonts.mjs",
    "generate:area-unlocks": "node scripts/generateAreaUnlocks.mjs",
    "generate:areas": "node scripts/generateAreaUnlocks.mjs",
    "test:register-controls": "npm run build && node tests/registerControls.browser.mjs",
    "test:settings-save": "npm run build && node tests/settingsSave.browser.mjs",
    "test:home-customization": "tsx tests/homeDesign.test.ts && npm run build && node tests/homeCustomization.browser.mjs",
    "test:home-layout": "npm run build && node tests/homeLayout.browser.mjs",
    "test:preferences": "tsx tests/dlcHomePreferences.test.ts && npm run build && node tests/preferences.browser.mjs",
    "test:catchability": "tsx tests/catchability.test.ts",
    "test:starter-lock": "tsx tests/starterLock.test.ts",
    "test:pokeball": "tsx tests/pokeball.test.ts",
    "test:game-progress-sync": "tsx tests/gameProgressSync.test.ts",
    "test:offline-patch": "node tests/offlinePatch.browser.mjs",
    "test:auth-gateway": "npm run build && node tests/authGateway.browser.mjs",
    "test:sync": "node --experimental-strip-types tests/syncDiagnostics.test.ts || npx tsx tests/syncDiagnostics.test.ts",
    "test:sync-queue": "npm run build && node tests/syncQueue.browser.mjs",
    "test:sprites": "node tests/sprites.browser.mjs",
    "generate:breeding": "node scripts/generateBreedingData.mjs",
    "test:maps": "tsx tests/maps.test.ts && npm run build && node tests/maps.browser.mjs && node tests/homeLayout.browser.mjs",
    "test:breeding": "tsx tests/breeding.test.ts && npm run build && node tests/breeding.browser.mjs",
    "generate:sprites": "tsx scripts/downloadSprites.ts && node scripts/bundleSprites.mjs",
    "bundle:sprites": "node scripts/bundleSprites.mjs",
    "test:customization": "npm run build && node tests/customization.browser.mjs",
    "test:trainer-card": "npm run build && node tests/trainerCard.browser.mjs",
    "generate:items": "node scripts/generateItemsData.mjs",
    "test:items": "tsx tests/items.test.ts && npm run build && node tests/items.browser.mjs",
    "generate:item-sprites": "node scripts/downloadItemSprites.mjs && node scripts/appendItemSprites.mjs",
    "test:region-progress": "npm run build && node tests/regionProgress.browser.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
